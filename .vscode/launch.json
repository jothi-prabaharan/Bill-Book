{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Web · Development (Edge, 4200)",
      "type": "msedge",
      "request": "launch",
      "preLaunchTask": "serve-web",
      "url": "http://localhost:4200",
      "webRoot": "${workspaceFolder}/frontend",
      "sourceMaps": true,
      "sourceMapPathOverrides": {
        "webpack:///./~/*": "${workspaceFolder}/frontend/node_modules/*",
        "webpack:///./*": "${workspaceFolder}/frontend/*",
        "webpack:///*": "*",
        "webpack://_N_E/*": "${workspaceFolder}/frontend/*",
        "/apps/*": "${workspaceFolder}/frontend/apps/*",
        "/libs/*": "${workspaceFolder}/frontend/libs/*"
      },
      "resolveSourceMapLocations": [
        "${workspaceFolder}/frontend/**",
        "!${workspaceFolder}/frontend/node_modules/**"
      ],
      "userDataDir": "${workspaceFolder}/.vscode/.edge-debug-profile/web",
      "runtimeArgs": [
        "--disable-features=CalculateNativeWinOcclusion"
      ]
    },
    {
      "name": "Web · Staging (Edge, 4200)",
      "type": "msedge",
      "request": "launch",
      "preLaunchTask": "serve-web-staging",
      "url": "http://localhost:4200",
      "webRoot": "${workspaceFolder}/frontend",
      "sourceMaps": true,
      "sourceMapPathOverrides": {
        "webpack:///./~/*": "${workspaceFolder}/frontend/node_modules/*",
        "webpack:///./*": "${workspaceFolder}/frontend/*",
        "webpack:///*": "*",
        "webpack://_N_E/*": "${workspaceFolder}/frontend/*",
        "/apps/*": "${workspaceFolder}/frontend/apps/*",
        "/libs/*": "${workspaceFolder}/frontend/libs/*"
      },
      "resolveSourceMapLocations": [
        "${workspaceFolder}/frontend/**",
        "!${workspaceFolder}/frontend/node_modules/**"
      ],
      "userDataDir": "${workspaceFolder}/.vscode/.edge-debug-profile/web",
      "runtimeArgs": [
        "--disable-features=CalculateNativeWinOcclusion"
      ]
    },
    {
      "name": "Docs · Development (Edge, 4300)",
      "type": "msedge",
      "request": "launch",
      "preLaunchTask": "serve-docs",
      "url": "http://localhost:4300",
      "webRoot": "${workspaceFolder}/frontend",
      "sourceMaps": true,
      "sourceMapPathOverrides": {
        "webpack:///./~/*": "${workspaceFolder}/frontend/node_modules/*",
        "webpack:///./*": "${workspaceFolder}/frontend/*",
        "webpack:///*": "*",
        "webpack://_N_E/*": "${workspaceFolder}/frontend/*",
        "/apps/*": "${workspaceFolder}/frontend/apps/*",
        "/libs/*": "${workspaceFolder}/frontend/libs/*"
      },
      "resolveSourceMapLocations": [
        "${workspaceFolder}/frontend/**",
        "!${workspaceFolder}/frontend/node_modules/**"
      ],
      "userDataDir": "${workspaceFolder}/.vscode/.edge-debug-profile/docs",
      "runtimeArgs": [
        "--disable-features=CalculateNativeWinOcclusion"
      ]
    },
    {
      "name": "Docs · Staging (Edge, 4300)",
      "type": "msedge",
      "request": "launch",
      "preLaunchTask": "serve-docs-staging",
      "url": "http://localhost:4300",
      "webRoot": "${workspaceFolder}/frontend",
      "sourceMaps": true,
      "sourceMapPathOverrides": {
        "webpack:///./~/*": "${workspaceFolder}/frontend/node_modules/*",
        "webpack:///./*": "${workspaceFolder}/frontend/*",
        "webpack:///*": "*",
        "webpack://_N_E/*": "${workspaceFolder}/frontend/*",
        "/apps/*": "${workspaceFolder}/frontend/apps/*",
        "/libs/*": "${workspaceFolder}/frontend/libs/*"
      },
      "resolveSourceMapLocations": [
        "${workspaceFolder}/frontend/**",
        "!${workspaceFolder}/frontend/node_modules/**"
      ],
      "userDataDir": "${workspaceFolder}/.vscode/.edge-debug-profile/docs",
      "runtimeArgs": [
        "--disable-features=CalculateNativeWinOcclusion"
      ]
    },
    {
      "name": "Desktop (Electron)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/frontend",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "nx",
        "run",
        "desktop:serve"
      ],
      "sourceMaps": true,
      "console": "integratedTerminal"
    }
  ],
  "compounds": [
    {
      "name": "Frontend only (Web + Docs, Development)",
      "configurations": [
        "Web · Development (Edge, 4200)",
        "Docs · Development (Edge, 4300)"
      ],
      "stopAll": true
    },
    {
      "name": "Frontend only (Web + Docs, Staging)",
      "configurations": [
        "Web · Staging (Edge, 4200)",
        "Docs · Staging (Edge, 4300)"
      ],
      "stopAll": true
    }
  ]
}
