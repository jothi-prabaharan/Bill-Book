    "configurations": [
        {
            "name": "Web · Development (Edge, 4200)",
            "type": "msedge",
            "request": "launch",
            "preLaunchTask": "serve-web",
            "url": "http://localhost:4200",
            "webRoot": "${workspaceFolder}/frontend",
            "sourceMaps": true,
            "sourceMapPathOverrides": {
                "webpack:///./~/*": "${workspaceFolder}/frontend/node_modules/*",
                "webpack:///./*": "${workspaceFolder}/frontend/*",
                "webpack:///*": "*",
                "webpack://_N_E/*": "${workspaceFolder}/frontend/*",
                "/apps/*": "${workspaceFolder}/frontend/apps/*",
                "/libs/*": "${workspaceFolder}/frontend/libs/*"
            },
            "resolveSourceMapLocations": [
                "${workspaceFolder}/frontend/**",
                "!${workspaceFolder}/frontend/node_modules/**"
            ],
            "userDataDir": false,
            "runtimeArgs": [
                "--disable-features=CalculateNativeWinOcclusion"
            ],
            "presentation": {
                "hidden": true
            }
        },
        {
            "name": "Web App (Dev Server · :4200)",
            "type": "node",
            "request": "launch",
            "program": "${workspaceFolder}/.vscode/serve-angular.js",
            "args": [
                "web",
                "4200",
                "development"
            ],
            "cwd": "${workspaceFolder}/frontend",
            "console": "integratedTerminal",
            "presentation": {
                "hidden": true,
                "group": "frontend",
                "order": 2
            }
        },
