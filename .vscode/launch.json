    {
      "name": "Reporting.Api (5010)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-backend",
      "program": "${workspaceFolder}/backend/Api/Reporting/Reporting.Api/bin/Debug/net10.0/Reporting.Api.dll",
      "cwd": "${workspaceFolder}/backend/Api/Reporting/Reporting.Api",
