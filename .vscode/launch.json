    },
    {
      "name": "Sales.Api (5011)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-backend",
      "program": "${workspaceFolder}/backend/Api/Sales/Sales.Api/bin/Debug/net10.0/Sales.Api.dll",
      "cwd": "${workspaceFolder}/backend/Api/Sales/Sales.Api",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5011"
      },
      "console": "integratedTerminal",
