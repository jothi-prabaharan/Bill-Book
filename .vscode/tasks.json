    // ── Backend: build all API services in one pass (for compound launches) ──
    // Uses the .slnf filter to exclude test and worker projects.
    {
      "label": "build-backend-solution",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/backend/Bill-Book.Debug.slnf",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary;ForceNoAlign"
      ],
      "problemMatcher": "$msCompile",
      "group": "build"
    },
    // ── Backend microservice build tasks ──────────────────────────────
    // UseSharedCompilation=false prevents VBCSCompiler from holding locks
    // on Shared.Kernel.dll when multiple services build concurrently.
    {
      "label": "build-gateway",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/backend/Gateway/Gateway.Api/Gateway.Api.csproj",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary;ForceNoAlign",
        "/p:UseSharedCompilation=false"
      ],
      "problemMatcher": "$msCompile",
      "group": "build"
    },
