{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build-backend",
      "type": "shell",
      "command": "dotnet",
      "args": ["build", "${workspaceFolder}/backend/Bill-Book.Debug.slnf"],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "web-install",
      "type": "shell",
      "command": "npm",
      "args": ["install"],
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "problemMatcher": []
    },
    {
      "label": "serve-web",
      "type": "shell",
      // Wrapper rather than `npx nx serve web` directly: it reuses a dev server
      // that is already on 4200 instead of hanging on Angular's interactive
      // "use a different port?" prompt. See .vscode/serve-web.js.
      "command": "node",
      "args": ["${workspaceFolder}/.vscode/serve-web.js"],
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "isBackground": true,
      "problemMatcher": {
        "owner": "typescript",
        "fileLocation": ["relative", "${workspaceFolder}/frontend"],
        "pattern": {
          "regexp": "^([^\\s].*)\\((\\d+,\\d+)\\):\\s+(error|warning|info)\\s+(TS\\d+)\\s*:\\s*(.*)$",
          "file": 1,
          "location": 2,
          "severity": 3,
          "code": 4,
          "message": 5
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "(Building|Watch mode enabled|nx run web:serve|Reusing the dev server)",
          "endsPattern": "(Local:|listening on|Compiled successfully|Application bundle generation complete)"
        }
      }
    }
  ]
}
