{
  "$comment": [
    "The cases both tax implementations must agree on, to the paisa.",
    "",
    "Read by Shared.Kernel.Tests (GstCalculatorFixtureTests) and by",
    "line-math.spec.ts. Two implementations of one sum diverge without either",
    "looking wrong, and a GST return is where that surfaces months later — this",
    "file is what makes the divergence a failing test instead.",
    "",
    "Amounts here are in RUPEES with two decimals, which is how C# holds them.",
    "The TypeScript works in integer paise because JavaScript has no decimal, so",
    "its spec multiplies by 100 on the way in and divides on the way out. That",
    "conversion is the only thing the two sides are allowed to do differently.",
    "",
    "Quantities carry six decimals. Rates are percentages with four.",
    "",
    "Adding a case: put it here first, watch both suites fail, then fix both."
  ],

  "rates": {
    "gst18": {
      "taxMasterId": 1,
      "taxGroupId": 18,
      "taxSystemName": "GST18",
      "totalRate": 18.0,
      "cgstRate": 9.0,
      "sgstRate": 9.0,
      "igstRate": 18.0,
      "cessRate": 0.0
    },
    "gst5": {
      "taxMasterId": 2,
      "taxGroupId": 5,
      "taxSystemName": "GST5",
      "totalRate": 5.0,
      "cgstRate": 2.5,
      "sgstRate": 2.5,
      "igstRate": 5.0,
      "cessRate": 0.0
    },
    "gst3Bullion": {
      "taxMasterId": 3,
      "taxGroupId": 3,
      "taxSystemName": "GST3",
      "totalRate": 3.0,
      "cgstRate": 1.5,
      "sgstRate": 1.5,
      "igstRate": 3.0,
      "cessRate": 0.0
    },
    "gst28Cess12": {
      "taxMasterId": 4,
      "taxGroupId": 28,
      "taxSystemName": "GST28C12",
      "totalRate": 28.0,
      "cgstRate": 14.0,
      "sgstRate": 14.0,
      "igstRate": 28.0,
      "cessRate": 12.0
    },
    "gst0": {
      "taxMasterId": 5,
      "taxGroupId": 0,
      "taxSystemName": "GST0",
      "totalRate": 0.0,
      "cgstRate": 0.0,
      "sgstRate": 0.0,
      "igstRate": 0.0,
      "cessRate": 0.0
    }
  },

  "lineCases": [
    {
      "name": "intra-state, exclusive, no discount",
      "why": "The ordinary sale. Eighteen per cent splits nine and nine.",
      "context": { "isInterState": false, "discountBeforeTax": true },
      "line": {
        "quantity": 2.0,
        "unitPrice": 500.0,
        "isPriceInclusive": false,
        "taxTreatment": "Taxable",
        "rate": "gst18"
      },
      "expected": {
        "grossAmount": 1000.0,
        "discountAmount": 0.0,
        "taxableAmount": 1000.0,
        "taxAmount": 180.0,
        "lineTotal": 1180.0,
        "components": [
          { "component": "Cgst", "rate": 9.0, "amount": 90.0 },
          { "component": "Sgst", "rate": 9.0, "amount": 90.0 }
        ]
      }
    },
    {
      "name": "inter-state, exclusive",
      "why": "The same sale across a state line is one component, not two.",
      "context": { "isInterState": true, "discountBeforeTax": true },
      "line": {
        "quantity": 2.0,
        "unitPrice": 500.0,
        "isPriceInclusive": false,
        "taxTreatment": "Taxable",
        "rate": "gst18"
      },
      "expected": {
        "grossAmount": 1000.0,
        "discountAmount": 0.0,
        "taxableAmount": 1000.0,
        "taxAmount": 180.0,
        "lineTotal": 1180.0,
        "components": [{ "component": "Igst", "rate": 18.0, "amount": 180.0 }]
      }
    },
    {
      "name": "discount before tax",
      "why": "A trade discount reduces what tax is charged on.",
      "context": { "isInterState": false, "discountBeforeTax": true },
      "line": {
        "quantity": 1.0,
        "unitPrice": 1000.0,
        "discountPercent": 10.0,
        "isPriceInclusive": false,
        "taxTreatment": "Taxable",
        "rate": "gst18"
      },
      "expected": {
        "grossAmount": 1000.0,
        "discountAmount": 100.0,
        "taxableAmount": 900.0,
        "taxAmount": 162.0,
        "lineTotal": 1062.0,
        "components": [
          { "component": "Cgst", "rate": 9.0, "amount": 81.0 },
          { "component": "Sgst", "rate": 9.0, "amount": 81.0 }
        ]
      }
    },
    {
      "name": "discount after tax",
      "why": "A settlement discount does not reduce GST liability, and must still show.",
      "context": { "isInterState": false, "discountBeforeTax": false },
      "line": {
        "quantity": 1.0,
        "unitPrice": 1000.0,
        "discountPercent": 10.0,
        "isPriceInclusive": false,
        "taxTreatment": "Taxable",
        "rate": "gst18"
      },
      "expected": {
        "grossAmount": 1000.0,
        "discountAmount": 100.0,
        "taxableAmount": 1000.0,
        "taxAmount": 180.0,
        "lineTotal": 1180.0,
        "components": [
          { "component": "Cgst", "rate": 9.0, "amount": 90.0 },
          { "component": "Sgst", "rate": 9.0, "amount": 90.0 }
        ]
      }
    },
    {
      "name": "MRP inclusive, intra-state",
      "why": "The bug that shipped once: dividing by the rate scale where the rate is a percent made every inclusive line a hundredth of its taxable value. 118 inclusive of 18% is exactly 100.",
      "context": { "isInterState": false, "discountBeforeTax": true },
      "line": {
        "quantity": 1.0,
        "unitPrice": 118.0,
        "isPriceInclusive": true,
        "taxTreatment": "Taxable",
        "rate": "gst18"
      },
      "expected": {
        "grossAmount": 118.0,
        "discountAmount": 0.0,
        "taxableAmount": 100.0,
        "taxAmount": 18.0,
        "lineTotal": 118.0,
        "components": [
          { "component": "Cgst", "rate": 9.0, "amount": 9.0 },
          { "component": "Sgst", "rate": 9.0, "amount": 9.0 }
        ]
      }
    },
    {
      "name": "MRP inclusive that does not divide evenly",
      "why": "999 inclusive of 18% backs out to 846.61, and the tax is what is left. The rounding point is the taxable value, not the tax.",
      "context": { "isInterState": true, "discountBeforeTax": true },
      "line": {
        "quantity": 1.0,
        "unitPrice": 999.0,
        "isPriceInclusive": true,
        "taxTreatment": "Taxable",
        "rate": "gst18"
      },
      "expected": {
        "grossAmount": 999.0,
        "discountAmount": 0.0,
        "taxableAmount": 846.61,
        "taxAmount": 152.39,
        "lineTotal": 999.0,
        "components": [{ "component": "Igst", "rate": 18.0, "amount": 152.39 }]
      }
    },
    {
      "name": "exempt carries no tax rows at all",
      "why": "Exempt is not zero-rated. GSTR-1 files them in different tables, and the absence of the rows is the fact.",
      "context": { "isInterState": false, "discountBeforeTax": true },
      "line": {
        "quantity": 3.0,
        "unitPrice": 100.0,
        "isPriceInclusive": false,
        "taxTreatment": "Exempt",
        "rate": null
      },
      "expected": {
        "grossAmount": 300.0,
        "discountAmount": 0.0,
        "taxableAmount": 300.0,
        "taxAmount": 0.0,
        "lineTotal": 300.0,
        "components": []
      }
    },
    {
      "name": "zero-rated keeps its rows, at rate zero",
      "why": "An export. Every amount is zero, so only the presence of the rows says which side of the return it belongs on.",
      "context": { "isInterState": true, "discountBeforeTax": true },
      "line": {
        "quantity": 3.0,
        "unitPrice": 100.0,
        "isPriceInclusive": false,
        "taxTreatment": "ZeroRated",
        "rate": "gst0"
      },
      "expected": {
        "grossAmount": 300.0,
        "discountAmount": 0.0,
        "taxableAmount": 300.0,
        "taxAmount": 0.0,
        "lineTotal": 300.0,
        "components": [{ "component": "Igst", "rate": 0.0, "amount": 0.0 }]
      }
    },
    {
      "name": "cess rides on top of the intra-state split",
      "why": "Three components, not two. A fixed set of tax columns would have nowhere to put this.",
      "context": { "isInterState": false, "discountBeforeTax": true },
      "line": {
        "quantity": 1.0,
        "unitPrice": 1000.0,
        "isPriceInclusive": false,
        "taxTreatment": "Taxable",
        "rate": "gst28Cess12"
      },
      "expected": {
        "grossAmount": 1000.0,
        "discountAmount": 0.0,
        "taxableAmount": 1000.0,
        "taxAmount": 400.0,
        "lineTotal": 1400.0,
        "components": [
          { "component": "Cgst", "rate": 14.0, "amount": 140.0 },
          { "component": "Sgst", "rate": 14.0, "amount": 140.0 },
          { "component": "Cess", "rate": 12.0, "amount": 120.0 }
        ]
      }
    },
    {
      "name": "half-paise rounds away from zero, per component",
      "why": "10.10 at 2.5% is 0.2525 and rounds to 0.25; the pair sums to 0.50. Rounding the 5% once would give 0.51. The component is the rounded unit because GSTR-1 reconciles per rate.",
      "context": { "isInterState": false, "discountBeforeTax": true },
      "line": {
        "quantity": 1.0,
        "unitPrice": 10.1,
        "isPriceInclusive": false,
        "taxTreatment": "Taxable",
        "rate": "gst5"
      },
      "expected": {
        "grossAmount": 10.1,
        "discountAmount": 0.0,
        "taxableAmount": 10.1,
        "taxAmount": 0.5,
        "lineTotal": 10.6,
        "components": [
          { "component": "Cgst", "rate": 2.5, "amount": 0.25 },
          { "component": "Sgst", "rate": 2.5, "amount": 0.25 }
        ]
      }
    },
    {
      "name": "fractional quantity at the bullion rate",
      "why": "Gold is sold by the gram to three decimals and the 3% slab sits outside the standard five.",
      "context": { "isInterState": false, "discountBeforeTax": true },
      "line": {
        "quantity": 12.345,
        "unitPrice": 6250.0,
        "isPriceInclusive": false,
        "taxTreatment": "Taxable",
        "rate": "gst3Bullion"
      },
      "expected": {
        "grossAmount": 77156.25,
        "discountAmount": 0.0,
        "taxableAmount": 77156.25,
        "taxAmount": 2314.68,
        "lineTotal": 79470.93,
        "components": [
          { "component": "Cgst", "rate": 1.5, "amount": 1157.34 },
          { "component": "Sgst", "rate": 1.5, "amount": 1157.34 }
        ]
      }
    },
    {
      "name": "a discount larger than the line is capped",
      "why": "A negative taxable value posts as a credit nobody raised.",
      "context": { "isInterState": false, "discountBeforeTax": true },
      "line": {
        "quantity": 1.0,
        "unitPrice": 100.0,
        "discountAmount": 150.0,
        "isPriceInclusive": false,
        "taxTreatment": "Taxable",
        "rate": "gst18"
      },
      "expected": {
        "grossAmount": 100.0,
        "discountAmount": 100.0,
        "taxableAmount": 0.0,
        "taxAmount": 0.0,
        "lineTotal": 0.0,
        "components": [
          { "component": "Cgst", "rate": 9.0, "amount": 0.0 },
          { "component": "Sgst", "rate": 9.0, "amount": 0.0 }
        ]
      }
    }
  ],

  "documentCases": [
    {
      "name": "three lines at one rate foot to the sum of the lines",
      "why": "The header has to equal what is printed above it, because somebody always adds them up. Each 0.25 pair rounds on the line, and the header sums the rounded figures.",
      "context": { "isInterState": false, "discountBeforeTax": true },
      "lines": [
        { "quantity": 1.0, "unitPrice": 10.1, "isPriceInclusive": false, "taxTreatment": "Taxable", "rate": "gst5" },
        { "quantity": 1.0, "unitPrice": 10.1, "isPriceInclusive": false, "taxTreatment": "Taxable", "rate": "gst5" },
        { "quantity": 1.0, "unitPrice": 10.1, "isPriceInclusive": false, "taxTreatment": "Taxable", "rate": "gst5" }
      ],
      "expected": {
        "subTotal": 30.3,
        "discountAmount": 0.0,
        "taxableAmount": 30.3,
        "cgstAmount": 0.75,
        "sgstAmount": 0.75,
        "igstAmount": 0.0,
        "cessAmount": 0.0,
        "totalAmount": 31.8
      }
    },
    {
      "name": "mixed treatments on one document",
      "why": "A taxable line, an exempt line and a zero-rated line coexist, and only the first contributes tax.",
      "context": { "isInterState": true, "discountBeforeTax": true },
      "lines": [
        { "quantity": 1.0, "unitPrice": 1000.0, "isPriceInclusive": false, "taxTreatment": "Taxable", "rate": "gst18" },
        { "quantity": 1.0, "unitPrice": 500.0, "isPriceInclusive": false, "taxTreatment": "Exempt", "rate": null },
        { "quantity": 1.0, "unitPrice": 250.0, "isPriceInclusive": false, "taxTreatment": "ZeroRated", "rate": "gst0" }
      ],
      "expected": {
        "subTotal": 1750.0,
        "discountAmount": 0.0,
        "taxableAmount": 1750.0,
        "cgstAmount": 0.0,
        "sgstAmount": 0.0,
        "igstAmount": 180.0,
        "cessAmount": 0.0,
        "totalAmount": 1930.0
      }
    }
  ],

  "placeOfSupplyCases": [
    {
      "name": "same state is intra-state",
      "branchStateCode": "33",
      "placeOfSupplyStateCode": "33",
      "contactGstin": "33AAAAA0000A1Z5",
      "expected": { "outcome": "Ok", "stateCode": "33", "isInterState": false }
    },
    {
      "name": "different state is inter-state",
      "branchStateCode": "33",
      "placeOfSupplyStateCode": "29",
      "contactGstin": "29AAAAA0000A1Z5",
      "expected": { "outcome": "Ok", "stateCode": "29", "isInterState": true }
    },
    {
      "name": "no place of supply falls back to the GSTIN",
      "why": "The ordinary case: the field is left alone and the customer's registration decides.",
      "branchStateCode": "33",
      "placeOfSupplyStateCode": null,
      "contactGstin": "27AAAAA0000A1Z5",
      "expected": { "outcome": "Ok", "stateCode": "27", "isInterState": true }
    },
    {
      "name": "a GSTIN contradicting the place of supply is refused",
      "why": "One of the two is wrong and there is no way to tell which. Choosing silently files the tax under the wrong head.",
      "branchStateCode": "33",
      "placeOfSupplyStateCode": "29",
      "contactGstin": "27AAAAA0000A1Z5",
      "expected": { "outcome": "GstinContradictsPlaceOfSupply" }
    },
    {
      "name": "an unregistered customer with a place of supply is fine",
      "why": "B2C. No GSTIN to contradict anything.",
      "branchStateCode": "33",
      "placeOfSupplyStateCode": "33",
      "contactGstin": null,
      "expected": { "outcome": "Ok", "stateCode": "33", "isInterState": false }
    },
    {
      "name": "neither a place of supply nor a GSTIN is refused",
      "branchStateCode": "33",
      "placeOfSupplyStateCode": null,
      "contactGstin": null,
      "expected": { "outcome": "PlaceOfSupplyUnknown" }
    },
    {
      "name": "a branch with no state code cannot determine anything",
      "branchStateCode": null,
      "placeOfSupplyStateCode": "33",
      "contactGstin": null,
      "expected": { "outcome": "BranchStateUnknown" }
    },
    {
      "name": "a single-digit state code is padded, not treated as a different state",
      "why": "09 on a GSTIN is easily stored as 9, and the two comparing unequal would make every supply in that state inter-state.",
      "branchStateCode": "9",
      "placeOfSupplyStateCode": "09",
      "contactGstin": "09AAAAA0000A1Z5",
      "expected": { "outcome": "Ok", "stateCode": "09", "isInterState": false }
    },
    {
      "name": "a malformed GSTIN is refused rather than ignored",
      "branchStateCode": "33",
      "placeOfSupplyStateCode": "33",
      "contactGstin": "NOTAGSTIN",
      "expected": { "outcome": "GstinMalformed" }
    }
  ]
}
