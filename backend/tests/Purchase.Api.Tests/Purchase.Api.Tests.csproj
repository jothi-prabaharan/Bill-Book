<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Xunit.SkippableFact" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Api\Purchase\Purchase.Api\Purchase.Api.csproj" />

    <!-- Purchase and Accounting share one per-customer database in production,
         and acc.NumberingSeries lives in it: Accounting migrates that table,
         Purchase maps it with ExcludeFromMigrations so a POR number is allocated
         inside Purchase's own transaction. A test database built from Purchase's
         migrations alone would not have it, so the fixture migrates both — which
         is what the real database looks like. The reference is the test's, never
         the service's, exactly as in Inventory.Api.Tests. -->
    <ProjectReference Include="..\..\Api\Accounting\Accounting.Repository\Accounting.Repository.csproj" />
  </ItemGroup>


  <ItemGroup>
    <!-- The permission catalogue lives in Master, and the guard test asserts
         that every module and permission these controllers demand is one the
         catalogue seeds. A test's reference, never the service's — Purchase
         does not read Master's DbContext at run time and must not. -->
    <ProjectReference Include="..\..\Api\Master\Master.Repository\Master.Repository.csproj" />
  </ItemGroup>

</Project>


