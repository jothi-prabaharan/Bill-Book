<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <!-- Versions are unverified: this repository has never been restored or built.
       Expect to correct them on the first `dotnet restore`. -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.0" />
    <!-- Must track Npgsql.EntityFrameworkCore.PostgreSQL above: that package
         requires Npgsql >= 10.0.0, and pinning this one to 9.0.2 made every
         project referencing both fail to restore with NU1109. -->
    <PackageVersion Include="Npgsql" Version="10.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.0" />
    <PackageVersion Include="System.IdentityModel.Tokens.Jwt" Version="8.3.0" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.0" />
    <!-- Microsoft.AspNetCore.OpenApi 10.0.0 pulls Microsoft.OpenApi 2.0.0, which carries
         GHSA-v5pm-xwqc-g5wc. Pinned transitively to 2.7.5, the first patched 2.x release.
         2.7.5 is also new enough that IOpenApiMediaType.Example is read-only, which breaks
         the XML-comment source generator in AspNetCore.OpenApi 10.0.0. That generator is
         removed in Directory.Build.targets — read the note there before touching this pin. -->
    <PackageVersion Include="Microsoft.OpenApi" Version="2.7.5" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.0" />
    <PackageVersion Include="Yarp.ReverseProxy" Version="2.3.0" />
    <PackageVersion Include="BCrypt.Net-Next" Version="4.0.3" />
    <PackageVersion Include="Azure.Identity" Version="1.13.1" />
    <PackageVersion Include="Azure.Security.KeyVault.Secrets" Version="4.7.0" />
    <PackageVersion Include="Azure.Messaging.ServiceBus" Version="7.18.2" />
    <PackageVersion Include="Azure.Storage.Blobs" Version="12.22.2" />
    <!-- Reading and writing .xlsx, for bank statement import and export.
         Microsoft's own, MIT, no licence key — unlike the Syncfusion suite used
         for PDF. Pinned at 3.5.1 rather than 3.1.x: the older line drags in
         System.IO.Packaging 8.0.0, which carries two high-severity advisories,
         and this solution builds with TreatWarningsAsErrors. -->
    <PackageVersion Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageVersion Include="PDFsharp" Version="6.1.1" />
    <!-- Allow-list HTML sanitiser for print template segments, on write. MIT,
         built on AngleSharp, so it parses rather than pattern-matches — a regex
         cannot be trusted with this. Configured in SegmentSanitizer, which must
         keep contenteditable and the pt-chip class or the editor's placeholder
         round trip breaks.

         Pinned at 9.2.1039 rather than the 9.0.x line: 9.0.886 carries
         GHSA-j92c-7v7g-gj3f and drags in AngleSharp 0.17.1, which carries
         GHSA-pgww-w46g-26qg. Both are NU1902 warnings, and this solution builds
         with TreatWarningsAsErrors, so the older line does not restore at all. -->
    <PackageVersion Include="HtmlSanitizer" Version="9.2.1039" />
    <!-- The DOM the renderer walks. It arrives under HtmlSanitizer anyway, but
         PrintSubstitution calls its API directly, so it is declared rather than
         relied on as a transitive that a sanitiser upgrade could move. -->
    <PackageVersion Include="AngleSharp" Version="1.7.2" />
  </ItemGroup>
  <!-- Test-only. Same caveat as above, and more sharply: these have never been
       restored either, and xunit v3 changed its package layout, so expect the
       first `dotnet restore` to want corrections here. -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageVersion Include="xunit" Version="2.9.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
    <!-- Runtime skips. The Accounting suite needs a real PostgreSQL for the
         triggers and the guarded updates, and xunit 2.x has no way to skip a
         test from inside it. Without this the choice is a suite that fails on a
         machine with no server, or one that passes without running. -->
    <PackageVersion Include="Xunit.SkippableFact" Version="1.5.23" />
  </ItemGroup>
</Project>

