<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AngleSharp" />
    <PackageReference Include="Azure.Storage.Blobs" />
    <!-- Both already pinned in Directory.Packages.props; the vault-backed
         ISecretStore is what was missing, not the dependency. -->
    <PackageReference Include="Azure.Identity" />
    <PackageReference Include="Azure.Security.KeyVault.Secrets" />
    <!-- The Google Cloud counterparts of the three Azure packages above:
         Secret Manager for ISecretStore, Cloud Storage for IFileStorage,
         Pub/Sub for IEventPublisher. All three implementations live here beside
         their Azure and local siblings, so a service references no provider
         directly and picks one from configuration at startup. -->
    <PackageReference Include="Google.Cloud.SecretManager.V1" />
    <PackageReference Include="Google.Cloud.Storage.V1" />
    <PackageReference Include="Google.Cloud.PubSub.V1" />
    <PackageReference Include="HtmlSanitizer" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Npgsql" />
  </ItemGroup>

</Project>
