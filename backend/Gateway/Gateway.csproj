<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Gateway.Entity and Gateway.Repository sit underneath this project's directory,
    and the Web SDK's default globs would compile their sources into this assembly
    as well, producing duplicate type definitions. Excluded explicitly.
  -->
  <ItemGroup>
    <Compile Remove="Gateway.Entity\**" />
    <Compile Remove="Gateway.Repository\**" />
    <Content Remove="Gateway.Entity\**" />
    <Content Remove="Gateway.Repository\**" />
    <None Remove="Gateway.Entity\**" />
    <None Remove="Gateway.Repository\**" />
    <EmbeddedResource Remove="Gateway.Entity\**" />
    <EmbeddedResource Remove="Gateway.Repository\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Yarp.ReverseProxy" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="Gateway.Repository\Gateway.Repository.csproj" />
  </ItemGroup>

</Project>
