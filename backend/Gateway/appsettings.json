{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "MasterDatabase": ""
  },
  "RequestLog": {
    "Enabled": true,
    "BatchSize": 200,
    "FlushIntervalSeconds": 5,
    "QueueCapacity": 10000,
    "RetentionDays": 30,
    "PurgeIntervalHours": 24,
    "ExcludedPaths": [
      "/health",
      "/"
    ]
  },
  "ReverseProxy": {
    "Routes": {
      "identity-auth": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "identity-users": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/api/users/{**catch-all}"
        }
      },
      "identity-roles": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/api/roles/{**catch-all}"
        }
      },
      "platform-customers": {
        "ClusterId": "platform",
        "Match": {
          "Path": "/api/customers/{**catch-all}"
        }
      },
      "master-reference": {
        "ClusterId": "master",
        "Match": {
          "Path": "/api/master/{**catch-all}"
        }
      },
      "platform-smtp": {
        "ClusterId": "platform",
        "Match": {
          "Path": "/api/smtp-settings/{**catch-all}"
        }
      },
      "platform-orgs": {
        "ClusterId": "platform",
        "Match": {
          "Path": "/api/organizations/{**catch-all}"
        }
      },
      "accounting-accounts": {
        "ClusterId": "accounting",
        "Match": {
          "Path": "/api/accounts/{**catch-all}"
        }
      },
      "accounting-subaccounts": {
        "ClusterId": "accounting",
        "Match": {
          "Path": "/api/sub-accounts/{**catch-all}"
        }
      },
      "accounting-taxes": {
        "ClusterId": "accounting",
        "Match": {
          "Path": "/api/tax-masters/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "identity": {
        "Destinations": {
          "d1": {
            "Address": ""
          }
        }
      },
      "platform": {
        "Destinations": {
          "d1": {
            "Address": ""
          }
        }
      },
      "master": {
        "Destinations": {
          "d1": {
            "Address": ""
          }
        }
      },
      "accounting": {
        "Destinations": {
          "d1": {
            "Address": ""
          }
        }
      }
    }
  }
}
