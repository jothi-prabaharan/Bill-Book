{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "identity-auth": {
        "ClusterId": "identity",
        "Match": { "Path": "/api/auth/{**catch-all}" }
      },
      "identity-users": {
        "ClusterId": "identity",
        "Match": { "Path": "/api/users/{**catch-all}" }
      },
      "identity-roles": {
        "ClusterId": "identity",
        "Match": { "Path": "/api/roles/{**catch-all}" }
      },
      "platform-customers": {
        "ClusterId": "platform",
        "Match": { "Path": "/api/customers/{**catch-all}" }
      },
      "master-reference": {
        "ClusterId": "master",
        "Match": { "Path": "/api/master/{**catch-all}" }
      }
    },
    "Clusters": {
      "identity": {
        "Destinations": { "d1": { "Address": "http://localhost:5001/" } }
      },
      "platform": {
        "Destinations": { "d1": { "Address": "http://localhost:5002/" } }
      },
      "master": {
        "Destinations": { "d1": { "Address": "http://localhost:5003/" } }
      }
    }
  }
}
