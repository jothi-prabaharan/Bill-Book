{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "MasterDatabase": ""
  },
  "RequestLog": {
    "Enabled": true,
    "BatchSize": 200,
    "FlushIntervalSeconds": 5,
    "QueueCapacity": 10000,
    "RetentionDays": 30,
