      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Accounting.Repository\Accounting.Repository.csproj" />
  </ItemGroup>

</Project>
