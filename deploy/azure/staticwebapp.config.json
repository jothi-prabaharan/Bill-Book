{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/assets/*", "/*.{js,css,ico,png,svg,woff,woff2,json,md}", "/content/*"]
  },
  "routes": [
    {
      "route": "/config.js",
      "headers": {
        "cache-control": "no-cache, no-store, must-revalidate"
      }
    },
    {
      "route": "/index.html",
      "headers": {
        "cache-control": "no-cache"
      }
    }
  ],
  "globalHeaders": {
    "x-content-type-options": "nosniff",
    "referrer-policy": "strict-origin-when-cross-origin",
    "x-frame-options": "DENY"
  },
  "mimeTypes": {
    ".md": "text/markdown"
  }
}
