{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "web",
  "projectType": "application",
  "sourceRoot": "apps/web/src",
  "tags": ["type:app", "platform:browser"],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/apps/web",
        "index": "apps/web/src/index.html",
        "browser": "apps/web/src/main.ts",
        "tsConfig": "apps/web/tsconfig.json",
        "polyfills": ["zone.js"],
        "styles": ["apps/web/src/styles.scss"]
      },
      "configurations": {
        "production": {
          "budgets": [
            { "type": "initial", "maximumWarning": "500kb", "maximumError": "1mb" }
          ],
          "outputHashing": "all",
          "fileReplacements": [
            {
              "replace": "apps/web/src/environments/environment.ts",
              "with": "apps/web/src/environments/environment.production.ts"
            }
          ]
        },
        "uat": {
          "budgets": [
            { "type": "initial", "maximumWarning": "500kb", "maximumError": "1mb" }
          ],
          "outputHashing": "all",
          "fileReplacements": [
            {
              "replace": "apps/web/src/environments/environment.ts",
              "with": "apps/web/src/environments/environment.uat.ts"
            }
          ]
        },
        "staging": {
          "budgets": [
            { "type": "initial", "maximumWarning": "500kb", "maximumError": "1mb" }
          ],
          "outputHashing": "all",
          "sourceMap": true,
          "fileReplacements": [
            {
              "replace": "apps/web/src/environments/environment.ts",
              "with": "apps/web/src/environments/environment.staging.ts"
            }
          ]
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "executor": "@angular/build:dev-server",
      "options": {
        "proxyConfig": "apps/web/proxy.conf.json",
        "port": 4200
      },
      "configurations": {
        "development": { "buildTarget": "web:build:development" },
        "staging": { "buildTarget": "web:build:staging" },
        "uat": { "buildTarget": "web:build:uat" },
        "production": { "buildTarget": "web:build:production" }
      },
      "defaultConfiguration": "development"
    }
  }
}
