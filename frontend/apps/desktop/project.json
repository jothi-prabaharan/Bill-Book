{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "desktop",
  "projectType": "application",
  "sourceRoot": "apps/desktop/src",
  "tags": ["type:app", "platform:electron"],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/apps/desktop",
        "index": "apps/desktop/src/index.html",
        "browser": "apps/desktop/src/main.ts",
        "tsConfig": "apps/desktop/tsconfig.json",
        "polyfills": ["zone.js"],
        "assets": [
          { "glob": "**/*", "input": "apps/desktop/src/assets", "output": "assets" },
          { "glob": "**/*", "input": "apps/web/src/assets", "output": "assets" }
        ],
        "styles": ["apps/desktop/src/styles.scss"]
      }
    },
    "serve-web": {
      "executor": "@angular/build:dev-server",
      "options": {
        "port": 4201,
        "buildTarget": "desktop:build"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "nx run desktop:serve-web",
          "set NODE_ENV=development&& electron apps/desktop/main.js"
        ],
        "parallel": true
      }
    }
  }
}
