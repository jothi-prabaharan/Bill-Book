<?xml version="1.0" encoding="utf-8"?>
<!--
  For an update folder served by IIS (TK-184). IIS answers 404 for a file type
  it has no MIME type for, which would stop every desktop update at latest.yml.
  Copy this file into the update folder beside version.json.
-->
<configuration>
  <system.webServer>
    <staticContent>
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <remove fileExtension=".yml" />
      <mimeMap fileExtension=".yml" mimeType="text/yaml" />
      <remove fileExtension=".blockmap" />
      <mimeMap fileExtension=".blockmap" mimeType="application/octet-stream" />
      <remove fileExtension=".AppImage" />
      <mimeMap fileExtension=".AppImage" mimeType="application/octet-stream" />
      <remove fileExtension=".deb" />
      <mimeMap fileExtension=".deb" mimeType="application/vnd.debian.binary-package" />
      <remove fileExtension=".dmg" />
      <mimeMap fileExtension=".dmg" mimeType="application/x-apple-diskimage" />
      <remove fileExtension=".exe" />
      <mimeMap fileExtension=".exe" mimeType="application/octet-stream" />
      <remove fileExtension=".zip" />
      <mimeMap fileExtension=".zip" mimeType="application/zip" />
    </staticContent>
  </system.webServer>
  <!-- version.json and the latest*.yml files change with every release; never let them be cached. -->
  <location path="version.json">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="DisableCache" />
      </staticContent>
    </system.webServer>
  </location>
  <location path="latest.yml">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="DisableCache" />
      </staticContent>
    </system.webServer>
  </location>
  <location path="latest-linux.yml">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="DisableCache" />
      </staticContent>
    </system.webServer>
  </location>
  <location path="latest-mac.yml">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="DisableCache" />
      </staticContent>
    </system.webServer>
  </location>
</configuration>
