{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "docs",
  "projectType": "application",
  "sourceRoot": "apps/docs/src",
  "tags": ["type:app", "platform:browser", "scope:docs"],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/apps/docs",
        "index": "apps/docs/src/index.html",
        "browser": "apps/docs/src/main.ts",
        "tsConfig": "apps/docs/tsconfig.json",
        "polyfills": ["zone.js"],
        "styles": ["apps/docs/src/styles.scss"],
        "assets": [
          {
            "glob": "**/*.md",
            "input": "apps/docs/content",
            "output": "content"
          }
        ]
      },
      "configurations": {
        "production": {
          "outputHashing": "all",
          "fileReplacements": [
            {
              "replace": "apps/docs/src/environments/environment.ts",
              "with": "apps/docs/src/environments/environment.production.ts"
            }
          ]
        },
        "uat": {
          "outputHashing": "all",
          "fileReplacements": [
            {
              "replace": "apps/docs/src/environments/environment.ts",
              "with": "apps/docs/src/environments/environment.uat.ts"
            }
          ]
        },
        "staging": {
          "outputHashing": "all",
          "sourceMap": true,
          "fileReplacements": [
            {
              "replace": "apps/docs/src/environments/environment.ts",
              "with": "apps/docs/src/environments/environment.staging.ts"
            }
          ]
        },
        "development": { "optimization": false, "sourceMap": true }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "executor": "@angular/build:dev-server",
      "options": {
        "port": 4202
      },
      "configurations": {
        "development": { "buildTarget": "docs:build:development" },
        "staging": { "buildTarget": "docs:build:staging" },
        "uat": { "buildTarget": "docs:build:uat" },
        "production": { "buildTarget": "docs:build:production" }
      },
      "defaultConfiguration": "development"
    }
  }
}
