{
  "_comment": [
    "Firebase Hosting for the four web apps. apps/desktop is Electron and is not",
    "hosted; it ships as an installer.",
    "",
    "One site per app rather than one site with four subdirectories, so each can",
    "carry its own domain and its own access: admin is the operator console and",
    "has no business being reachable on the customer's domain.",
    "",
    "The public directory is dist/apps/{app}/browser, not dist/apps/{app} — the",
    "@angular/build:application builder emits browser/ and server/ side by side,",
    "and pointing Hosting at the parent serves a directory listing of those two",
    "instead of the application.",
    "",
    "Create the sites once before the first deploy:",
    "  firebase hosting:sites:create <project>-web   (and portal, admin, docs)"
  ],
  "hosting": [
    {
      "target": "web",
      "public": "frontend/dist/apps/web/browser",
      "ignore": ["**/.*", "**/node_modules/**"],
      "rewrites": [
        {
          "_comment": "Single-page application: the router owns the path, so every unknown one is index.html rather than a 404. Without this every deep link and every refresh away from / breaks.",
          "source": "**",
          "destination": "/index.html"
        }
      ],
      "headers": [
        {
          "_comment": "Hashed build output is immutable, so it is cached for a year. index.html is not hashed and must never be, or a deploy leaves browsers on the old application indefinitely.",
          "source": "**/*.@(js|css|woff2)",
          "headers": [
            { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
          ]
        },
        {
          "source": "/index.html",
          "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
        }
      ]
    },
    {
      "target": "portal",
      "public": "frontend/dist/apps/portal/browser",
      "ignore": ["**/.*", "**/node_modules/**"],
      "rewrites": [{ "source": "**", "destination": "/index.html" }],
      "headers": [
        {
          "source": "**/*.@(js|css|woff2)",
          "headers": [
            { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
          ]
        },
        {
          "source": "/index.html",
          "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
        }
      ]
    },
    {
      "target": "admin",
      "public": "frontend/dist/apps/admin/browser",
      "ignore": ["**/.*", "**/node_modules/**"],
      "rewrites": [{ "source": "**", "destination": "/index.html" }],
      "headers": [
        {
          "source": "**/*.@(js|css|woff2)",
          "headers": [
            { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
          ]
        },
        {
          "source": "/index.html",
          "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
        }
      ]
    },
    {
      "target": "docs",
      "public": "frontend/dist/apps/docs/browser",
      "ignore": ["**/.*", "**/node_modules/**"],
      "rewrites": [{ "source": "**", "destination": "/index.html" }],
      "headers": [
        {
          "source": "**/*.@(js|css|woff2)",
          "headers": [
            { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
          ]
        },
        {
          "source": "/index.html",
          "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
        }
      ]
    }
  ]
}
